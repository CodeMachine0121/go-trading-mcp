# 交易服務的位址。這一個填錯，其餘全部不會動。
TRADING_SERVICE_BASE_URL=http://localhost:8080

# 聽在哪張網卡上。預設只聽 loopback——這個端點沒有任何門鎖，
# 連得到的人就開得了一段連線並以自己的帳號登入。要對外開放請是個明確的動作。
# （在 Docker 裡必須是 0.0.0.0，門鎖改由發佈連接埠時綁 127.0.0.1 負責。）
SERVER_BIND_ADDRESS=127.0.0.1

# 這個外掛自己聽在哪個埠、掛在哪個路徑上。
SERVER_PORT=8090
MCP_PATH=/mcp

# 單次向交易服務請求的逾時（秒）。
TRADING_SERVICE_REQUEST_TIMEOUT_SECONDS=30

# 「看一眼即時更新」最長等幾秒。等滿沒收到東西是正常結果，不是錯誤。
LIVE_UPDATE_WAIT_LIMIT_SECONDS=10

# 一段連線閒置多久就放掉（分鐘）。放掉之後要重新登入。
# 設成 0 是永不放掉——那會讓連過的連線一直被留著，不建議。
IDLE_CONNECTION_TIMEOUT_MINUTES=60
