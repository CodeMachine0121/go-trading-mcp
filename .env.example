# 交易服務的位址（外掛自己連過去用的，可以是內部位址）。這一個填錯，其餘全部不會動。
TRADING_SERVICE_BASE_URL=http://localhost:8080

# 交易服務對外的位址，寫進授權說明，Claude Code 靠它找到授權伺服器。
TRADING_SERVICE_PUBLIC_URL=http://localhost:8080

# 這個外掛對外的位址（不含路徑）；外掛授權必須發給「這個位址 + MCP_PATH」。
PUBLIC_BASE_URL=http://localhost:8090

# 聽在哪張網卡上。預設只聽 loopback，要對外開放請是個明確的動作。
# （在 Docker 裡必須是 0.0.0.0。）
SERVER_BIND_ADDRESS=127.0.0.1

# 這個外掛自己聽在哪個埠、掛在哪個路徑上。
SERVER_PORT=8090
MCP_PATH=/mcp

# 單次向交易服務請求的逾時（秒）。
TRADING_SERVICE_REQUEST_TIMEOUT_SECONDS=30

# 四件重演自己的逾時（秒）。要比交易服務整次重演的允許時間長，讓它自己先說「沒跑完」。
TRADING_SERVICE_REPLAY_TIMEOUT_SECONDS=120

# 「看一眼即時更新」最長等幾秒。等滿沒收到東西是正常結果，不是錯誤。
LIVE_UPDATE_WAIT_LIMIT_SECONDS=10

# 一段連線閒置多久就放掉（分鐘）。放掉之後 Claude Code 會自己重開一段，不必重新授權。
IDLE_CONNECTION_TIMEOUT_MINUTES=60
